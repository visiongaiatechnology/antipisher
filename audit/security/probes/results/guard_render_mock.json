    },
    {
      "name": "guard:error-message-content",
      "detail": "Fehlermeldungen der Schutzseite geben nur generische Texte/Fehlercodes aus, nicht die Ziel-URL (guard.js:21-24,39)."
    },
    {
      "name": "clickjacking:tab-binding",
      "detail": "guard.html ist in Chrome web-accessible; ein Einbetten/Öffnen aus Web-Origins ist möglich. Die Freigabe-Message ist aber an sender.url=guard.html UND tab.url=guard.html gebunden (chrome/background.js:91-95; Mock-Test probe04). Ein iframe aus einer Webseite kann tabId nicht auf einen Guard-Tab umbiegen — der Angriff scheitert fail-closed. Kein Browser-E2E verfügbar."
    }
  ]
