{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Antipisher",
  "short_name": "Antipisher",
  "description": "__MSG_appDesc__",
  "version": "0.2.1",
  "version_name": "0.2.1 Alpha",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Antipisher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/sites.js",
        "shared/detector.js",
        "shared/i18n.js",
        "shared/shield-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/aegis-engine.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "aegis_trackers",
        "enabled": true,
        "path": "rulesets/trackers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "guard.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
